# HighhX Platform configuration (copy to .env; never commit real values)
HIGHHX_DATABASE_URL=postgresql+psycopg://highhx:CHANGE_ME@db:5432/highhx
HIGHHX_PUBLIC_URL=https://api.highhx.dev
HIGHHX_SIGNUP_ENABLED=true
HIGHHX_DEFAULT_PROVIDER=anthropic
HIGHHX_ADMIN_TOKEN=
# Upstream AI providers (configure at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
