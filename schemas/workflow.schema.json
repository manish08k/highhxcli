{
  "$id": "https://highhx.dev/schemas/workflow.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "on": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ],
      "description": "Events that trigger this workflow"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": {}
    },
    "settings": {
      "type": "object",
      "properties": {
        "fail_fast": {
          "type": "boolean"
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "timeout": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
            }
          ]
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique step identifier"
          },
          "name": {
            "type": "string",
            "description": "Display name"
          },
          "description": {
            "type": "string"
          },
          "run": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ],
            "description": "Command(s) to run"
          },
          "uses": {
            "type": "string",
            "minLength": 1,
            "description": "Name of another workflow to run as this step"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "description": "A HighhX action to run (see `highhx actions`)"
          },
          "with": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            },
            "description": "Inputs for 'uses' (workflow inputs) or 'action' (action inputs)"
          },
          "rollback": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "minLength": 1,
                "description": "A command that undoes the step"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "minLength": 1
                  },
                  "with": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  }
                },
                "additionalProperties": false,
                "required": [
                  "action"
                ]
              }
            ],
            "description": "How to undo this step when the workflow fails (on_failure: rollback)"
          },
          "depends_on": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "if": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "boolean"
              }
            ],
            "description": "Condition expression (or true/false)"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
              }
            ]
          },
          "retry": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "description": "Total attempts"
              },
              {
                "type": "object",
                "properties": {
                  "attempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "delay": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                      }
                    ]
                  },
                  "backoff": {
                    "type": "number",
                    "minimum": 1
                  },
                  "max_delay": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                      }
                    ]
                  },
                  "retry_on_timeout": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "attempts"
                ]
              }
            ]
          },
          "approval": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "risk": {
                    "type": "string",
                    "enum": [
                      "safe",
                      "normal",
                      "dangerous",
                      "critical"
                    ]
                  },
                  "bypassable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "continue_on_error": {
            "type": "boolean"
          },
          "shell": {
            "type": "boolean",
            "description": "Force (true) or forbid (false) running through a shell"
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "minItems": 1
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "on_failure": {
      "type": "string",
      "enum": [
        "stop",
        "rollback"
      ],
      "description": "stop (default), or rollback: undo completed steps in reverse order"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "steps"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HighhX workflow"
}
