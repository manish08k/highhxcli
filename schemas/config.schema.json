{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highhx.dev/schemas/config.schema.json",
  "title": "HighhX project configuration (.highhx/config.yaml)",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Config format version"
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "object",
      "properties": {
        "dev": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "lint": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "typecheck": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "type": "string",
          "minLength": 1
        },
        "update": {
          "type": "string",
          "minLength": 1
        },
        "clean": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "description": "Override the commands HighhX detected"
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "run": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "timeout": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "run"
        ]
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "health": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "expected_status": {
                "type": "integer",
                "minimum": 100,
                "maximum": 599
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                  }
                ]
              },
              "retries": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "interval": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ready_timeout": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "command"
        ]
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "default_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        },
        "targets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "production": {
                "type": "boolean"
              },
              "require_branch": {
                "type": "string"
              },
              "require_clean": {
                "type": "boolean"
              },
              "preflight": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "rollback_command": {
                "type": "string",
                "minLength": 1
              },
              "status_command": {
                "type": "string",
                "minLength": 1
              },
              "logs_command": {
                "type": "string",
                "minLength": 1
              },
              "host": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "user": {
                "type": "string"
              },
              "identity_file": {
                "type": "string"
              },
              "remote_dir": {
                "type": "string"
              },
              "compose_file": {
                "type": "string"
              },
              "service": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "build": {
                "type": "boolean"
              },
              "manifests": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "deployment": {
                "type": "string"
              },
              "directory": {
                "type": "string"
              },
              "vars": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "health_check": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expected_status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "timeout": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                      }
                    ]
                  },
                  "retries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "interval": {
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "auto_rollback": {
                "type": "boolean"
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
                  }
                ]
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "settings": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "additionalProperties": false,
            "required": [
              "type"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "url_env": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "migrations": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "directory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "seed": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "directory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "backups_dir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "tag_prefix": {
          "type": "string"
        },
        "changelog": {
          "type": "string"
        },
        "version_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publish_command": {
          "type": "string",
          "minLength": 1
        },
        "commit_message": {
          "type": "string"
        },
        "push": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_file_size": {
          "type": "integer",
          "minimum": 1024
        },
        "scan_untracked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "properties": {
        "auto_approve": {
          "type": "string",
          "enum": [
            "safe",
            "normal",
            "dangerous",
            "critical"
          ]
        },
        "yes_max_risk": {
          "type": "string",
          "enum": [
            "safe",
            "normal",
            "dangerous",
            "critical"
          ]
        },
        "typed_confirmation": {
          "type": "string",
          "enum": [
            "safe",
            "normal",
            "dangerous",
            "critical"
          ]
        },
        "non_bypassable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "enum": [
                  "safe",
                  "normal",
                  "dangerous",
                  "critical"
                ]
              },
              "reason": {
                "type": "string"
              },
              "bypassable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "pattern"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_code": {
          "type": "boolean"
        },
        "index": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "watch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ignore": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "debounce": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?\\s*(ms|s|m|h|d)?$"
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cron": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "cron"
        ]
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "highhx",
            "anthropic",
            "openai",
            "gemini"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "string",
          "enum": [
            "ask",
            "auto-edit",
            "read-only"
          ]
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 128000
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "instructions": {
          "type": "string",
          "description": "Extra instructions for the HighhX agent in this project"
        },
        "sync_sessions": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "HighhX Pro agent settings for this project"
    }
  },
  "additionalProperties": false
}
