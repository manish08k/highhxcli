{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highhx.dev/schemas/plugin.schema.json",
  "title": "HighhX plugin manifest (highhx-plugin.yaml)",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "api_version": {
      "type": "integer",
      "minimum": 1
    },
    "entry": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "commands",
          "subprocess",
          "network",
          "filesystem",
          "env",
          "deploy",
          "detectors"
        ]
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "enum": [
                  "safe",
                  "normal",
                  "dangerous",
                  "critical"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "run"
            ]
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "detectors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "language",
                  "framework",
                  "package_manager",
                  "database",
                  "container"
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "files"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "api_version"
  ]
}
